<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ControllerApp.ViewModels"
             x:Class="ControllerApp.Views.MainPage"
             x:DataType="vm:MainPageViewModel"
             Title="Басты бет"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Controller Profile Dashboard Header -->
            <Border StrokeThickness="0" BackgroundColor="{StaticResource Secondary}" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Контроллер профилі" FontSize="11" TextColor="{StaticResource TextSecondary}" FontAttributes="Bold" />
                        <Label Text="{Binding ControllerName}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{Binding ControllerNumber, StringFormat='Бағыт: № {0}'}" FontSize="13" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    
                    <Button Grid.Column="1" 
                            Text="Шығу" 
                            Command="{Binding LogoutCommand}" 
                            BackgroundColor="{StaticResource WarningRed}"
                            TextColor="White"
                            HeightRequest="36"
                            FontSize="12"
                            CornerRadius="8"
                            Padding="10,0" />
                </Grid>
            </Border>

            <!-- API Configuration Toggle Panel -->
            <VerticalStackLayout Spacing="5">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Сервер параметрлері" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Grid.Column="1" 
                            Text="{Binding IsApiSettingsVisible, Converter={StaticResource Key=Background}, ConverterParameter='Жасыру;Өзгерту'}" 
                            Command="{Binding ToggleApiSettingsCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            HeightRequest="30"
                            Padding="0"
                            FontSize="12">
                        <!-- Custom text binding trigger for toggle button -->
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsApiSettingsVisible}" Value="True">
                                <Setter Property="Text" Value="Сақтау" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsApiSettingsVisible}" Value="False">
                                <Setter Property="Text" Value="Баптау" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <Border IsVisible="{Binding IsApiSettingsVisible}" 
                        StrokeThickness="1" 
                        Stroke="{StaticResource BorderColor}" 
                        Padding="15" 
                        BackgroundColor="{StaticResource CardBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Сервер API мекенжайы" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeThickness="1" Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource Secondary}" Padding="10, 0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry Text="{Binding ApiUrl}" Placeholder="http://192.168.1.100:3000" HeightRequest="40" Margin="0" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Sync and Selection Card -->
            <Border StrokeThickness="1" Stroke="{StaticResource BorderColor}" Padding="20" BackgroundColor="{StaticResource CardBackground}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">
                    
                    <!-- Date Selection -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Күнді таңдаңыз" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeThickness="1" Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource Secondary}" Padding="10, 5">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <DatePicker Date="{Binding SelectedDate}" Format="dd.MM.yyyy" TextColor="{StaticResource TextPrimary}" HeightRequest="40" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Refresh/Download Button -->
                    <Button Text="Жаңарту (Деректерді жүктеу)" 
                            Command="{Binding SyncDataCommand}" 
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{StaticResource Primary}"
                            HeightRequest="48"
                            FontSize="14" />

                    <!-- Status Display -->
                    <Border StrokeThickness="0" BackgroundColor="#E6F0FF" Padding="12" Margin="0,5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label Text="{Binding StatusMessage}" FontSize="13" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    </Border>

                    <!-- Street Selection (Visible only after data loaded) -->
                    <VerticalStackLayout Spacing="5" IsVisible="{Binding IsDataLoaded}">
                        <Label Text="Көшені таңдаңыз" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                        <Border StrokeThickness="1" Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource Secondary}" Padding="10, 0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Picker Title="Көшені таңдаңыз"
                                    ItemsSource="{Binding Streets}"
                                    SelectedItem="{Binding SelectedStreet}"
                                    TextColor="{StaticResource TextPrimary}"
                                    HeightRequest="45" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Proceed Button -->
                    <Button Text="Абоненттер кестесіне өту" 
                            Command="{Binding ProceedCommand}" 
                            IsEnabled="{Binding IsDataLoaded}"
                            BackgroundColor="{StaticResource SuccessGreen}"
                            HeightRequest="50"
                            FontSize="15"
                            Margin="0, 10, 0, 0">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource SuccessGreen}" Offset="0,4" Radius="6" Opacity="0.3" />
                        </Button.Shadow>
                    </Button>
                    
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" HeightRequest="40" WidthRequest="40" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
