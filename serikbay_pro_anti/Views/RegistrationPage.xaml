<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ControllerApp.ViewModels"
             x:Class="ControllerApp.Views.RegistrationPage"
             x:DataType="vm:RegistrationViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ScrollView ContentContainerThickness="0">
        <Grid RowDefinitions="Auto, *" VerticalOptions="FillAndExpand">
            
            <!-- Beautiful Blue Gradient Header -->
            <Border Grid.Row="0"
                    StrokeThickness="0"
                    HeightRequest="250"
                    HorizontalOptions="FillAndExpand">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                        <GradientStop Color="{StaticResource PrimaryDark}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,30,30" />
                </Border.StrokeShape>

                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <Image Source="appiconfg.svg" HeightRequest="80" WidthRequest="80" HorizontalOptions="Center" />
                    <Label Text="Контроллер Тіркеу"
                           TextColor="White"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="Жүйені бастау үшін тіркеліңіз"
                           TextColor="#B3D4FF"
                           FontSize="14"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Registration Card Content -->
            <Grid Grid.Row="1" Margin="20, -30, 20, 20" RowDefinitions="Auto" VerticalOptions="Start">
                <Border BackgroundColor="{StaticResource CardBackground}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="25"
                        Margin="0, 0, 0, 10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.08" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">
                        <Label Text="Тіркеу деректері"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               Margin="0, 0, 0, 5" />

                        <!-- Controller ID -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Контроллер нөмірі"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeThickness="1"
                                    Stroke="{StaticResource BorderColor}"
                                    BackgroundColor="{StaticResource Secondary}"
                                    Padding="10, 0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding ControllerNumberStr}"
                                       Placeholder="Мысалы: 1"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       HeightRequest="45"
                                       Margin="0" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Controller Name -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Аты-жөні (ФИО)"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Border StrokeThickness="1"
                                    Stroke="{StaticResource BorderColor}"
                                    BackgroundColor="{StaticResource Secondary}"
                                    Padding="10, 0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding FullName}"
                                       Placeholder="Мысалы: Иванов Иван"
                                       Keyboard="Text"
                                       BackgroundColor="Transparent"
                                       HeightRequest="45"
                                       Margin="0" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Error Message -->
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource WarningRed}"
                               FontSize="13"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding ErrorMessage, Converter={VersionTracking} }"> <!-- Simplified triggers -->
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <!-- Register Button -->
                        <Button Text="Тіркелу"
                                Command="{Binding RegisterCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                HeightRequest="50"
                                FontSize="16"
                                Margin="0, 10, 0, 0"
                                VerticalOptions="End">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="6" Opacity="0.3" />
                            </Button.Shadow>
                        </Button>

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource Primary}"
                                           HeightRequest="40"
                                           WidthRequest="40" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
